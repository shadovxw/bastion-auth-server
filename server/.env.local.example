PORT=3001
DATABASE_URL=postgres://bastion:password@localhost:5432/bastion
REDIS_URL=redis://localhost:6379

JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_DAYS=30

# Leave empty for localhost — browser handles it correctly
COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_TTL_HOURS=24

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth/callback/google

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3001/oauth/callback/github

ADMIN_PERMISSION=auth:admin
