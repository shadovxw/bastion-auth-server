# Environment variables — never commit secrets
.env
.env.local
.env*.local

# RS256 keypair — losing these invalidates all tokens
server/keys/private.pem
server/keys/public.pem

# Go build artifacts
server/tmp/
server/bastion-server

# Node / Next.js
node_modules/
web/node_modules/
sdk/auth-browser/node_modules/
.next/
web/.next/
.turbo/

# Next.js build output
web/.next/
web/out/

# npm / pnpm / yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# TypeScript build output
sdk/auth-browser/dist/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
*.pid
